# Copy this file to .env and fill in real values for your environment.

# Local development database (see docker-compose.yml)
DATABASE_URL="postgresql://adotkazi:adotkazi@localhost:5432/adotkazi?schema=public"

# Redis (see docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (leave blank to log emails to the console instead of sending them)
RESEND_API_KEY=""
EMAIL_FROM="AdotKazi <onboarding@resend.dev>"

# App
APP_URL="http://localhost:3000"
