// Recruitment bounded context — see docs/Level 3-Data/ENTITY_SPECIFICATIONS/OPPORTUNITY_ENGINE.txt
//
// Stage 2 Phase 1 (Opportunity Engine core): job requisitions usable from the
// authenticated dashboard by org members. No public careers site, candidate
// accounts, applications, interviews, or offers yet — those are later phases
// that build on Opportunity/Pipeline/PipelineStage/HiringTeam/Skill below.

enum OpportunityType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  GRADUATE_PROGRAM
  APPRENTICESHIP
  VOLUNTEER
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

/// 7-value lifecycle (OPPORTUNITY_ENGINE.txt), not RECRUITMENT.txt's simpler
/// 6-value list — supports an optional approval gate before publishing.
enum OpportunityStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum OpportunityVisibility {
  PUBLIC
  ORGANIZATION_ONLY
  INVITATION_ONLY
  PRIVATE_DRAFT
}

/// A job requisition. See OPPORTUNITY_ENGINE.txt#Opportunity.
model Opportunity {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?      @map("branch_id") @db.Uuid
  branch         Branch?      @relation(fields: [branchId], references: [id])
  departmentId   String       @map("department_id") @db.Uuid
  department     Department   @relation(fields: [departmentId], references: [id])
  hiringTeamId   String?      @map("hiring_team_id") @db.Uuid
  hiringTeam     HiringTeam?  @relation(fields: [hiringTeamId], references: [id])
  pipelineId     String       @map("pipeline_id") @db.Uuid
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id])

  title            String
  slug             String
  description      String? @db.Text
  responsibilities String? @db.Text
  requirements     String? @db.Text
  benefits         String? @db.Text

  opportunityType OpportunityType  @map("opportunity_type")
  workplaceType   WorkplaceType    @map("workplace_type")
  experienceLevel ExperienceLevel? @map("experience_level")
  location        String?
  openings        Int              @default(1)
  salaryMin       Decimal?         @map("salary_min") @db.Decimal(12, 2)
  salaryMax       Decimal?         @map("salary_max") @db.Decimal(12, 2)
  currency        String?

  applicationDeadline DateTime? @map("application_deadline")
  publishAt           DateTime? @map("publish_at")
  closeAt             DateTime? @map("close_at")

  status     OpportunityStatus     @default(DRAFT)
  visibility OpportunityVisibility @default(PUBLIC)

  skillRequirements SkillRequirement[]
  applications      Application[]

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departmentId])
  @@index([pipelineId])
  @@map("opportunities")
}

/// An org-configured recruitment pipeline template. Reduced audit set —
/// matches Role's precedent as org configuration, not a per-candidate
/// transactional record.
model Pipeline {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  isDefault      Boolean      @default(false) @map("is_default")
  isSystem       Boolean      @default(false) @map("is_system")

  stages        PipelineStage[]
  opportunities Opportunity[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("pipelines")
}

/// One ordered stage within a Pipeline. No cascade on delete — pipelines are
/// soft-deleted, so hard-delete cascade would rarely fire; cascade is
/// reserved for pure junction tables (see RolePermission).
model PipelineStage {
  id             String   @id @default(uuid(7)) @db.Uuid
  pipelineId     String   @map("pipeline_id") @db.Uuid
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id])
  name           String
  order          Int
  color          String?
  isTerminal     Boolean  @default(false) @map("is_terminal")
  allowsFeedback Boolean  @default(true) @map("allows_feedback")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

/// Groups the people involved in hiring for an Opportunity. Schema only this
/// phase — no CRUD screens yet, Opportunity.hiringTeamId stays nullable.
model HiringTeam {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?

  opportunities Opportunity[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("hiring_teams")
}

/// Global skill lookup, not org-scoped (see SCHEMA_GUIDELINES.txt).
model Skill {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @unique
  category String?

  requirements SkillRequirement[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("skills")
}

/// Explicit junction between Opportunity and Skill (see SCHEMA_GUIDELINES.txt:
/// "Always use explicit junction models").
model SkillRequirement {
  opportunityId    String      @map("opportunity_id") @db.Uuid
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId          String      @map("skill_id") @db.Uuid
  skill            Skill       @relation(fields: [skillId], references: [id])
  requirementLevel String?     @map("requirement_level")
  minimumYears     Int?        @map("minimum_years")

  @@id([opportunityId, skillId])
  @@index([skillId])
  @@map("opportunity_skill_requirements")
}

/// Thin now — id + userId only. RECRUITMENT_ENTITIES.txt's full profile
/// (headline, experience, education, portfolio) is a later phase; this seam
/// exists now so Application references Candidate, not User directly,
/// avoiding a migration when the full profile is built out.
model Candidate {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@map("candidates")
}

/// One candidate's submission to one opportunity. The resume is stored
/// per-application (not on Candidate) so it stays within the existing
/// org-scoped StorageProvider contract (FILE_STORAGE.txt) — a reusable,
/// cross-organization candidate resume is a later phase.
/// HIRED is set when an Offer is accepted (see Offer below); WITHDRAWN
/// (candidate self-service) still has no consumer. Independent of
/// currentStageId; see RECRUITMENT_ENTITIES.txt.
enum ApplicationStatus {
  ACTIVE
  REJECTED
  HIRED
}

model Application {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])
  opportunityId  String         @map("opportunity_id") @db.Uuid
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id])
  candidateId    String         @map("candidate_id") @db.Uuid
  candidate      Candidate      @relation(fields: [candidateId], references: [id])
  currentStageId String?        @map("current_stage_id") @db.Uuid
  currentStage   PipelineStage? @relation(fields: [currentStageId], references: [id])

  coverNote         String? @map("cover_note") @db.Text
  resumeFilename    String  @map("resume_filename")
  resumeStoragePath String  @map("resume_storage_path")

  status ApplicationStatus @default(ACTIVE)

  appliedAt DateTime @default(now()) @map("applied_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers     Offer[]
  interviews Interview[]
  notes      ApplicationNote[]

  @@unique([candidateId, opportunityId])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([currentStageId])
  @@map("applications")
}

/// RECRUITMENT.txt's full lifecycle also has DRAFT — omitted since nothing
/// in this phase creates a draft offer; add it if/when an approval-before-send
/// step is built. "Only one active (SENT) offer per application" is an
/// application-layer rule (offer.service.ts), not a DB constraint, since an
/// application may accumulate multiple resolved offer revisions over time.
enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

/// An employment offer extended for an Application. See
/// RECRUITMENT_ENTITIES.txt#Offer. Who sent/responded is on AuditEvent, not
/// here — same pattern as Application not storing a reviewer field.
model Offer {
  id            String      @id @default(uuid(7)) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id])

  status    OfferStatus @default(SENT)
  salary    Decimal?    @db.Decimal(12, 2)
  currency  String?
  startDate DateTime?   @map("start_date")
  expiresAt DateTime?   @map("expires_at")

  acceptedAt  DateTime? @map("accepted_at")
  declinedAt  DateTime? @map("declined_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([applicationId])
  @@map("offers")
}

/// RECRUITMENT.txt's supported interview types.
enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  TECHNICAL
  PANEL
  ASSESSMENT_REVIEW
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// A scorecard recommendation on InterviewFeedback — the common ATS
/// 4-point scale. InterviewScore's per-competency scoring
/// (RECRUITMENT_ENTITIES.txt) is a later phase; this alone already
/// captures "recommendation" from RECRUITMENT.txt's interview record list.
enum InterviewRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

/// A scheduled interview for an Application. See
/// RECRUITMENT_ENTITIES.txt#Interview.
model Interview {
  id            String      @id @default(uuid(7)) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id])

  interviewType   InterviewType   @map("interview_type")
  scheduledStart  DateTime        @map("scheduled_start")
  scheduledEnd    DateTime        @map("scheduled_end")
  meetingProvider String?         @map("meeting_provider")
  meetingLink     String?         @map("meeting_link")
  location        String?
  status          InterviewStatus @default(SCHEDULED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  interviewers InterviewParticipant[]
  feedback     InterviewFeedback[]

  @@index([applicationId])
  @@map("interviews")
}

/// Explicit junction between Interview and Membership (see
/// SCHEMA_GUIDELINES.txt: "Always use explicit junction models").
model InterviewParticipant {
  interviewId  String     @map("interview_id") @db.Uuid
  interview    Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@id([interviewId, membershipId])
  @@index([membershipId])
  @@map("interview_participants")
}

/// One interviewer's independent feedback on an Interview. Immutable after
/// submission (RECRUITMENT_ENTITIES.txt) — the service layer never exposes
/// an update path, only create. One row per [interview, membership].
model InterviewFeedback {
  id           String     @id @default(uuid(7)) @db.Uuid
  interviewId  String     @map("interview_id") @db.Uuid
  interview    Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id])

  recommendation InterviewRecommendation
  comments       String?                 @db.Text

  submittedAt DateTime @default(now()) @map("submitted_at")

  @@unique([interviewId, membershipId])
  @@map("interview_feedback")
}

/// Internal recruiter collaboration note on an Application (RECRUITMENT.txt
/// "Collaboration": Notes). Never shown to candidates. Create-only, like
/// InterviewFeedback — a note is a timestamped record, not an editable doc.
model ApplicationNote {
  id                 String      @id @default(uuid(7)) @db.Uuid
  applicationId      String      @map("application_id") @db.Uuid
  application        Application @relation(fields: [applicationId], references: [id])
  authorMembershipId String      @map("author_membership_id") @db.Uuid
  author             Membership  @relation(fields: [authorMembershipId], references: [id])

  body String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("application_notes")
}
